# Master key for envelope encryption of connector credentials.
# 32 bytes, base64. Generate with: npm run key:init (writes it outside the
# project), or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# NEVER commit the real value. In production it should come from a KMS. When
# this is unset the app reads ~/.config/ai-visibility-auditor/master.key, which
# is deliberately outside the project: a key kept beside its own ciphertext is
# not encryption. With neither, the app refuses to start rather than storing
# credentials in the clear.
AIVA_MASTER_KEY=

# Where sealed credentials, changes, batches and the audit log are stored.
AIVA_DATA=.aiva/state.json

# Recorded in the audit log against everything approved or applied here.
AIVA_OPERATOR=

# The server binds to loopback by default. It holds credentials that can change
# live websites, so only set AIVA_HOST deliberately.
AIVA_PORT=4317
# AIVA_HOST=127.0.0.1

# Integration tests point here; tools/playground.mjs serves WordPress on this port.
AIVA_TEST_WP_PORT=9400
